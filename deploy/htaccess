# Code Concept Community — codeconceptcafe.com (cPanel/LiteSpeed)
Options -Indexes
AddDefaultCharset utf-8

# MIME types some shared hosts are missing
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType image/webp .webp

RewriteEngine On

# leave cert-validation paths alone so the free SSL can issue/renew
RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
RewriteRule ^ - [L]

# http -> https (the PWA install and service worker require https)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# www -> apex
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # static assets: cache for a year (URLs carry a ?v= content hash)
  <FilesMatch "\.(css|js|woff2|webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # the app shell must always revalidate — these rules come last so they win
  <FilesMatch "^(sw\.js|manifest\.webmanifest|index\.html|404\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
